// 再帰版フィボナッチ
fn fib(n) {
  if (n < 2) { return n }
  return fib(n - 1) + fib(n - 2)
}

for (i in range(15)) {
  print("fib(" + str(i) + ") =", fib(i))
}

// ループ版 (while)
fn fibLoop(n) {
  let a = 0
  let b = 1
  while (n > 0) {
    let t = a + b
    a = b
    b = t
    n -= 1
  }
  return a
}
print("fibLoop(50) =", fibLoop(50))
print("fib(25) =", fib(25))
