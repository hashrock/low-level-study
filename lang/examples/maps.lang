// マップ (挿入順を保持) と単語カウント
const text = ["the", "cat", "sat", "on", "the", "mat", "the", "end"]
let counts = {}
for (w in text) {
  if (has(counts, w)) {
    counts[w] += 1
  } else {
    counts[w] = 1
  }
}
print(counts)
for (k in counts) {        // マップの for-in はキーを列挙
  print(k, "->", counts[k])
}
print("keys:", keys(counts), "size:", len(counts))

