print(type(user), type(user.tags), type(user.age), type(nil), type(print))

// continue の例: 奇数だけ合計
let sum = 0
for (i in range(10)) {
  if (i % 2 == 0) { continue }
  sum += i
}
print("odd sum:", sum)
